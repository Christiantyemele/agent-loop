# ----------------------------------------------------------------------------
# agent-loop · environment variables
# ----------------------------------------------------------------------------
# Copy this file to `.env` and fill in YOUR values, or export the variables in
# your shell before launching JupyterLab / cargo run. Values left empty fall
# back to the library defaults, so nothing here is hardcoded.
#
#   cp .env.example .env   # then edit with your endpoint/model
#   set -a; source .env; set +a
#
# Precedence: real shell exports ALWAYS win over .env; .env fills any unset var.
# ----------------------------------------------------------------------------

# --- OpenAI-compatible endpoint -----------------------------------------------
# Base URL of any OpenAI-compatible server, including the `/v1` suffix.
#   OpenAI : https://api.openai.com/v1
#   Ollama : http://localhost:11434/v1
#   vLLM   : http://localhost:8000/v1
# Leave empty to use the default (https://api.openai.com/v1).
OPENAI_BASE_URL=

# API key for the endpoint. Leave empty for local servers that need no auth.
OPENAI_API_KEY=

# --- Model selection ------------------------------------------------------------
# Model name the agent uses by default (unset => gpt-4o-mini).
# Examples: gpt-4o, gpt-4o-mini, llama3.1, claude-*, qwen2.5, your-gateway-model
AGENT_LOOP_MODEL=

# --- Optional: web search backend -----------------------------------------------
# API key for Tavily, used by the `web_search` tool (optional). If unset, the
# tool reports no backend and the agent falls back to web_fetch.
TAVILY_API_KEY=
