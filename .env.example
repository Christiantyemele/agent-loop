# ----------------------------------------------------------------------------
# agent-loop · environment variables
# ----------------------------------------------------------------------------
# All variables the runbook reads. Copy this file to `.env` and adjust, or
# export the values in your shell before launching JupyterLab / cargo run.
#
#   cp .env.example .env   # then edit
#   set -a; source .env; set +a
# ----------------------------------------------------------------------------

# --- OpenAI-compatible endpoint -----------------------------------------------
# Base URL of any OpenAI-compatible server (OpenAI, Ollama, vLLM, LM Studio,
# a corporate gateway, ...). Includes the `/v1` suffix.
#
# Offline rehearsal (included in this repo):
#   python3 scripts/mock_server.py 8000
#   OPENAI_BASE_URL=http://localhost:8000/v1
#
# Real examples:
#   OpenAI : https://api.openai.com/v1
#   Ollama : http://localhost:11434/v1
OPENAI_BASE_URL=http://localhost:8000/v1

# API key. Required by hosted endpoints; can be left as-is for local servers
# and the included mock server.
OPENAI_API_KEY=sk-mock

# --- Model selection ------------------------------------------------------------
# Default model used by the agent when none is otherwise specified.
# Examples: mock-model, gpt-4o-mini, llama3.1, qwen2.5, ...
AGENT_LOOP_MODEL=mock-model

# --- Optional: web search backend -----------------------------------------------
# API key for Tavily, used by the `web_search` tool. If unset, `web_search`
# reports that no backend is configured and the agent falls back to `web_fetch`.
TAVILY_API_KEY=
